# Miktos StreamLab - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================================================
# OBS WebSocket Configuration
# ============================================================================

OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_obs_websocket_password_here

# ============================================================================
# YouTube Streaming Keys (Week 5-6: Dual-Path Egress)
# ============================================================================

# YouTube English Channel
# Get your stream key from: https://studio.youtube.com/channel/YOUR_CHANNEL/livestreaming
# Format: xxxx-xxxx-xxxx-xxxx (4 groups of alphanumeric characters)
YOUTUBE_EN_STREAM_KEY=your_youtube_en_stream_key_here

# YouTube French Channel
# Get your stream key from: https://studio.youtube.com/channel/YOUR_CHANNEL/livestreaming
# Format: xxxx-xxxx-xxxx-xxxx (4 groups of alphanumeric characters)
YOUTUBE_FR_STREAM_KEY=your_youtube_fr_stream_key_here

# ============================================================================
# NGINX RTMP Relay (Week 5-6)
# ============================================================================

# NGINX RTMP relay configuration
# The application will stream to NGINX at rtmp://localhost/live
# NGINX will relay to multiple destinations (YouTube EN + FR)
NGINX_RTMP_HOST=localhost
NGINX_RTMP_PORT=1935
NGINX_RTMP_APP=live

# ============================================================================
# SRT Backup Destination (Week 6)
# ============================================================================

# SRT relay for backup streaming
# Format: srt://host:port?mode=caller&latency=300
SRT_BACKUP_URL=srt://your_srt_relay_host:9000?mode=caller&latency=300

# ============================================================================
# Application Settings
# ============================================================================

DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

